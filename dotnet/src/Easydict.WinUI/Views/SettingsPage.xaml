<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Easydict.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Easydict.WinUI.Views" xmlns:controls="using:Easydict.WinUI.Views.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/SettingsPageResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
            <local:BoolToCompactMarginConverter x:Key="BoolToCompactMarginConverter"/>
            <local:BoolToCompactFontSizeConverter x:Key="BoolToCompactFontSizeConverter"/>
            <local:BoolToItalicFontStyleConverter x:Key="BoolToItalicFontStyleConverter"/>
            <ItemsPanelTemplate x:Key="SettingsRailItemsPanel">
                <StackPanel Spacing="6"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="SettingsCompactTabsPanel">
                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7"/>
            </ItemsPanelTemplate>
<DataTemplate x:Key="SettingsRailItemTemplate">
                                <Button Click="OnSettingsTabClick"
                                        Loaded="OnSettingsTabButtonLoaded"
                                        Tag="{Binding Id}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Style="{StaticResource SettingsTabButtonStyle}"
                                        Width="192"
                                        Height="40"
                                        Margin="0"
                                        Padding="0"
                                        Background="{Binding Background}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource EasydictControlCornerRadius}"
                                        Foreground="{Binding Foreground}"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <StackPanel Spacing="12" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding IconGlyph}"
                                                      FontSize="16"
                                                      Foreground="{Binding Foreground}"
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       Foreground="{Binding Foreground}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Border
                                            Background="{Binding SelectedBackground}"
                                            BorderBrush="{Binding SelectedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource EasydictControlCornerRadius}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <StackPanel Spacing="12" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="12,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <FontIcon Glyph="{Binding IconGlyph}"
                                                      FontSize="16"
                                                      Foreground="{Binding SelectedForeground}"
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       Foreground="{Binding SelectedForeground}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
<DataTemplate x:Key="SettingsCompactTabItemTemplate">
                                <Button Click="OnSettingsTabClick"
                                        Loaded="OnSettingsTabButtonLoaded"
                                        Tag="{Binding Id}"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Style="{StaticResource SettingsTabButtonStyle}"
                                        Width="86"
                                        Height="76"
                                        Margin="0,0,10,10"
                                        Padding="0"
                                        Background="{Binding Background}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource EasydictControlCornerRadius}"
                                        Foreground="{Binding Foreground}"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <StackPanel Spacing="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding IconGlyph}"
                                                      FontSize="22"
                                                      Foreground="{Binding Foreground}"
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       Foreground="{Binding Foreground}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Border
                                            Background="{Binding SelectedBackground}"
                                            BorderBrush="{Binding SelectedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource EasydictControlCornerRadius}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <StackPanel Spacing="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <FontIcon Glyph="{Binding IconGlyph}"
                                                      FontSize="22"
                                                      Foreground="{Binding SelectedForeground}"
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       Foreground="{Binding SelectedForeground}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!-- Loading overlay (visible initially, hidden after init) -->
        <StackPanel x:Name="LoadingOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Spacing="12">
            <ProgressRing x:Name="LoadingOverlayRing"
                    IsActive="True"
                    Width="32"
                    Height="32"/>
        </StackPanel>

        <ScrollViewer x:Name="MainScrollViewer" HorizontalContentAlignment="Left"
                Padding="24"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
            <Grid x:Name="SettingsContentRoot" MaxWidth="1280" HorizontalAlignment="Left" RowSpacing="16" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsNavigationColumn" Width="192"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Grid x:Name="HeaderSection" Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal"
                            Spacing="12">
                        <Button x:Name="BackButton"
                                AutomationProperties.AutomationId="BackButton"
                                AutomationProperties.Name="Back"
                                Click="OnBackClick"
                                Style="{StaticResource SettingsAccentButtonStyle}"
                                Padding="8">
                            <FontIcon Glyph="&#xE72B;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Button>
                        <TextBlock x:Name="SettingsHeaderText"
                                Text="Settings"
                                FontSize="24"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Settings Tabs -->
                <ScrollViewer x:Name="SettingsNavigationScrollViewer" Grid.Row="1"
                              AutomationProperties.AutomationId="SettingsNavigationScrollViewer"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="SettingsNavigationRail" VerticalAlignment="Top">
                    <ItemsControl x:Name="SettingsTabsHost" HorizontalAlignment="Left" ItemsPanel="{StaticResource SettingsRailItemsPanel}" ItemTemplate="{StaticResource SettingsRailItemTemplate}"/>

                    <Grid IsHitTestVisible="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Height="0"
                          Canvas.ZIndex="1">
                        <ProgressRing x:Name="SettingsTabSwitchRing"
                                      Width="20"
                                      Height="20"
                                      Margin="0,6,4,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="Loading settings tab"/>
                    </Grid>
                </Grid>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsDetailsScrollViewer" Grid.Row="1" Grid.Column="1"
                              AutomationProperties.AutomationId="SettingsDetailsScrollViewer"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="TabContentHost">
                    <StackPanel x:Name="ServicesTabContent"
                                Spacing="24">
                    <!-- Service Overview -->
                    <StackPanel x:Name="EnabledServicesSection"
                            Spacing="12">
                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <TextBlock x:Name="EnabledServicesHeaderText"
                                    Text="Enabled Services"
                                    FontSize="18"
                                    FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <FontIcon x:Name="EnabledServicesHelpIcon"
                                    Glyph="&#xE897;"
                                    FontSize="14"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="EnabledServicesDescriptionText"
                                Text="Select which translation services to display in each window. Multiple services will run in parallel."
                                   FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <Button x:Name="ImportMdxDictionaryButton"
                                    Content="Import MDX Dictionary"
                                    Click="OnImportMdxDictionaryClicked"
                                    Padding="10,4"/>
                            <TextBlock x:Name="ImportedMdxSummaryText"
                                       Text="No MDX dictionaries imported"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- International Services Toggle -->
                        <Border Style="{StaticResource SettingsSectionStyle}"
                                Padding="12,8">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="EnableInternationalServicesHeaderText"
                                               Text="Enable International Services"
                                               FontSize="13"
                                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <ToggleSwitch x:Name="EnableInternationalServicesToggle"
                                                  Grid.Column="1"
                                                  Toggled="OnEnableInternationalServicesToggled"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="EnableInternationalServicesDescriptionText"
                                           Text="Some services require international network access."
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Service Configuration -->
                    <StackPanel x:Name="ServiceConfigurationSection"
                            Spacing="12">
                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <TextBlock x:Name="ServiceConfigurationHeaderText"
                                    Text="Service Configuration"
                                    FontSize="18"
                                    FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <FontIcon x:Name="ServiceConfigHelpIcon"
                                    Glyph="&#xE897;"
                                    FontSize="14"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ServiceConfigurationDescriptionText"
                                Text="Configure API keys, endpoints, and models for each translation service."
                                   FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- DeepL -->

                        <!-- Windows Local AI (Phi Silica, Foundry Local, and OpenVINO fallback) -->

                        <!-- Ollama (Local) -->

                        <!-- OpenAI -->

                        <!-- DeepSeek -->

                        <!-- Groq -->

                        <!-- Zhipu (智谱) -->

                        <!-- Kimi (Moonshot AI) -->

                        <!-- GitHub Models -->

                        <!-- Gemini -->

                        <!-- Custom OpenAI Compatible -->
                        <Expander HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Tag="CustomOpenAI">
                            <Expander.Header>
                                <Grid>
                                    <TextBlock Text="Custom OpenAI Compatible"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="CustomOpenAIStatusText"
                                            Text="✓"
                                            FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,8,0"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="12"
                                    Padding="0,8">
                                <TextBox x:Name="CustomOpenAIEndpointBox"
                                        Header="Endpoint (Required)"
                                        Width="450"
                                         PlaceholderText="https://your-api.example.com/v1/chat/completions"
                                        HorizontalAlignment="Left"/>
                                <StackPanel MaxWidth="350"
                                            HorizontalAlignment="Left"
                                            Spacing="4">
                                    <TextBlock x:Name="CustomOpenAIKeyHeaderText"
                                               Text="API Key (Optional)"
                                               FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <Grid>
                                        <PasswordBox x:Name="CustomOpenAIKeyBox"
                                                     HorizontalAlignment="Stretch"
                                                     Padding="12,5,40,5"
                                                     PlaceholderText="Enter API key if required"
                                                     PasswordRevealMode="Hidden"/>
                                        <Button x:Name="CustomOpenAIKeyRevealButton"
                                                AutomationProperties.AutomationId="CustomOpenAIKeyRevealButton"
                                                Style="{StaticResource SettingsInlineIconButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0"
                                                Tag="{Binding ElementName=CustomOpenAIKeyBox}"
                                                Click="OnPasswordRevealButtonClick">
                                            <FontIcon Glyph="&#xE890;"
                                                      FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <TextBox x:Name="CustomOpenAIModelBox"
                                        Header="Model"
                                        Width="200"
                                         PlaceholderText="gpt-3.5-turbo"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="Configure any OpenAI-compatible API endpoint (e.g., local LLM servers, other AI providers)."
                                           FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                                <Button x:Name="TestCustomOpenAIButton"
                                        Content="Test"
                                        Click="OnTestCustomOpenAI"
                                        Padding="8,4"/>
                            </StackPanel>
                        </Expander>

                        <!-- OpenRouter -->


                        <!-- Doubao (豆包) -->

                        <!-- Caiyun (彩云小译) -->

                        <!-- NiuTrans (小牛翻译) -->

                        <!-- Youdao (有道翻译) -->

                        <!-- Volcano Engine (火山翻译) -->

                        <!-- Claude Code (local agent CLI) -->

                        <!-- Codex (local agent CLI) -->

                        <!-- Imported MDX Dictionaries (dynamically populated) -->
                        <StackPanel x:Name="ImportedMdxConfigPanel"
                                Spacing="8"/>

                        <!-- Google Translate (No configuration needed) -->
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="FreeServicesHeaderText"
                                        Text="Free Services (No Configuration Required)"
                                        FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="16">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <Image Width="18"
                                               Height="18"
                                               Source="ms-appx:///Assets/ServiceIcons/Google.png"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Text="Google Translate"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="LingueeFreeServicePanel"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="Collapsed">
                                        <Image Width="18"
                                               Height="18"
                                               Source="ms-appx:///Assets/ServiceIcons/Linguee.png"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Text="Linguee Dictionary"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="FreeServicesDescriptionText"
                                        Text="Google Translate works out of the box without API keys."
                                           FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    </StackPanel>


                    <StackPanel x:Name="ViewsTabContent"
                                Spacing="12"
                                x:Load="False"
                                Visibility="Collapsed">
                        <StackPanel x:Name="WindowResultsSection"
                                    Spacing="10">
                            <TextBlock x:Name="WindowResultsHeaderText"
                                       Text="Window Results"
                                       FontSize="18"
                                       FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="WindowResultsDescriptionText"
                                       Text="Choose which results appear in each window and whether each result queries automatically."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <Border Style="{StaticResource SettingsSectionStyle}"
                                    Padding="12">
                                <StackPanel Spacing="14">
                                    <StackPanel x:Name="MainWindowSection"
                                                Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MainWindowHeaderText"
                                                       Text="Main Window"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Button x:Name="MainWindowReorderModeButton"
                                                    Grid.Column="1"
                                                    Click="OnToggleMainWindowReorderModeClicked"
                                                    Padding="6,1"
                                                    MinHeight="32"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl x:Name="MainWindowServicesPanel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="{Binding IsAvailable, Converter={StaticResource BoolToCompactMarginConverter}}"
                                                          MinHeight="32"
                                                          Opacity="{Binding IsAvailable, Converter={StaticResource BoolToOpacityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox
                                                            FontSize="{Binding IsAvailable, Converter={StaticResource BoolToCompactFontSizeConverter}}"
                                                            FontStyle="{Binding IsUnconfigured, Converter={StaticResource BoolToItalicFontStyleConverter}}"
                                                            Tag="{Binding ServiceId}"
                                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            MinHeight="32"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding DisplayName}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                                <Border Visibility="{Binding OriginBadgeVisibility}"
                                                                        Background="{ThemeResource PluginBadgeBackgroundBrush}"
                                                                        CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="{Binding OriginBadgeText}">
                                                                    <TextBlock Text="{Binding OriginBadgeText}" FontSize="10"
                                                                               Foreground="{ThemeResource PluginBadgeForegroundBrush}"
                                                                               AutomationProperties.AccessibilityView="Raw"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <ToggleSwitch
                                                            Grid.Column="1"
                                                            IsOn="{Binding EnabledQuery, Mode=TwoWay}"
                                                            Loaded="OnServiceToggleSwitchLoaded"
                                                            Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            MinWidth="0"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                        <Button
                                                            Grid.Column="2"
                                                            Click="OnMoveMainServiceUp"
                                                            Tag="{Binding ServiceId}"
                                                            ToolTipService.ToolTip="Move up"
                                                            Visibility="{Binding IsReorderModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Margin="4,0,0,0">
                                                            <FontIcon Glyph="&#xE70E;"
                                                                      FontSize="12"/>
                                                        </Button>
                                                        <Button
                                                            Grid.Column="3"
                                                            Click="OnMoveMainServiceDown"
                                                            Tag="{Binding ServiceId}"
                                                            ToolTipService.ToolTip="Move down"
                                                            Visibility="{Binding IsReorderModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Margin="2,0,0,0">
                                                            <FontIcon Glyph="&#xE70D;"
                                                                      FontSize="12"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Height="1"
                                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                                    <StackPanel x:Name="MiniWindowSection"
                                                Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MiniWindowHeaderText"
                                                       Text="Mini Window"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Button x:Name="MiniWindowReorderModeButton"
                                                    Grid.Column="1"
                                                    Click="OnToggleMiniWindowReorderModeClicked"
                                                    Padding="6,1"
                                                    MinHeight="32"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl x:Name="MiniWindowServicesPanel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="{Binding IsAvailable, Converter={StaticResource BoolToCompactMarginConverter}}"
                                                          MinHeight="32"
                                                          Opacity="{Binding IsAvailable, Converter={StaticResource BoolToOpacityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox
                                                            FontSize="{Binding IsAvailable, Converter={StaticResource BoolToCompactFontSizeConverter}}"
                                                            FontStyle="{Binding IsUnconfigured, Converter={StaticResource BoolToItalicFontStyleConverter}}"
                                                            Tag="{Binding ServiceId}"
                                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            MinHeight="32"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding DisplayName}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                                <Border Visibility="{Binding OriginBadgeVisibility}"
                                                                        Background="{ThemeResource PluginBadgeBackgroundBrush}"
                                                                        CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="{Binding OriginBadgeText}">
                                                                    <TextBlock Text="{Binding OriginBadgeText}" FontSize="10"
                                                                               Foreground="{ThemeResource PluginBadgeForegroundBrush}"
                                                                               AutomationProperties.AccessibilityView="Raw"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <ToggleSwitch
                                                            Grid.Column="1"
                                                            IsOn="{Binding EnabledQuery, Mode=TwoWay}"
                                                            Loaded="OnServiceToggleSwitchLoaded"
                                                            Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            MinWidth="0"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                        <Button
                                                            Grid.Column="2"
                                                            Click="OnMoveMiniServiceUp"
                                                            Tag="{Binding ServiceId}"
                                                            ToolTipService.ToolTip="Move up"
                                                            Visibility="{Binding IsReorderModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Margin="4,0,0,0">
                                                            <FontIcon Glyph="&#xE70E;"
                                                                      FontSize="12"/>
                                                        </Button>
                                                        <Button
                                                            Grid.Column="3"
                                                            Click="OnMoveMiniServiceDown"
                                                            Tag="{Binding ServiceId}"
                                                            ToolTipService.ToolTip="Move down"
                                                            Visibility="{Binding IsReorderModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Width="32"
                                                            Height="32"
                                                            Padding="0"
                                                            Margin="2,0,0,0">
                                                            <FontIcon Glyph="&#xE70D;"
                                                                      FontSize="12"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Height="1"
                                            Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                                    <StackPanel x:Name="FixedWindowSection"
                                                Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FixedWindowHeaderText"
                                                       Text="Fixed Window"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Button x:Name="FixedWindowReorderModeButton"
                                                    Grid.Column="1"
                                                    Click="OnToggleFixedWindowReorderModeClicked"
                                                    Padding="6,1"
                                                    MinHeight="32"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl x:Name="FixedWindowServicesPanel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
