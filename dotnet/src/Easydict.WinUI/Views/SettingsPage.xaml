                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="44,0,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>

                                <!-- Compact mode (issue #172) -->
                                <controls:FluentSettingRow>
<TextBlock Text="{Binding Header, ElementName=CompactModeToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
<ToggleSwitch x:Name="CompactModeToggle"
                                        Header="Compact mode">
<ToggleSwitch.HeaderTemplate>
<DataTemplate>
<Grid Height="0"/>
</DataTemplate>
</ToggleSwitch.HeaderTemplate>
</ToggleSwitch>
</controls:FluentSettingRow>
                                <TextBlock
                                    x:Name="CompactModeDescriptionText"
                                    Text="Reduce spacing while keeping language, progress and key actions visible."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>

                                <!-- Result font size (issue #172) -->
                                <TextBlock
                                    x:Name="ResultFontSizeLabel"
                                    Text="Result font size"
                                    FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Slider
                                    x:Name="ResultFontScaleSlider"
                                    Minimum="0.85"
                                    Maximum="1.4"
                                    StepFrequency="0.05"
                                    Width="250"
                                    HorizontalAlignment="Left"/>
                                <TextBlock
                                    x:Name="ResultFontSizeDescriptionText"
                                    Text="Adjust the font size of translation results."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>

                                <!-- Quick-action button visibility -->
                                <Expander x:Name="QuickActionsExpander"
                                          AutomationProperties.AutomationId="QuickActionsExpander"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock x:Name="QuickActionsHeaderText"
                                                   Text="Quick action buttons"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Spacing="12"
                                                Padding="0,8">
                                        <controls:FluentSettingRow>
        <TextBlock Text="{Binding Header, ElementName=ShowOcrButtonToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <ToggleSwitch x:Name="ShowOcrButtonToggle"
                                                Header="Show OCR button">
        <ToggleSwitch.HeaderTemplate>
        <DataTemplate>
        <Grid Height="0"/>
        </DataTemplate>
        </ToggleSwitch.HeaderTemplate>
        </ToggleSwitch>
        </controls:FluentSettingRow>
                                        <controls:FluentSettingRow>
        <TextBlock Text="{Binding Header, ElementName=ShowPinButtonToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <ToggleSwitch x:Name="ShowPinButtonToggle"
                                                Header="Show pin button">
        <ToggleSwitch.HeaderTemplate>
        <DataTemplate>
        <Grid Height="0"/>
        </DataTemplate>
        </ToggleSwitch.HeaderTemplate>
        </ToggleSwitch>
        </controls:FluentSettingRow>
                                        <controls:FluentSettingRow>
        <TextBlock Text="{Binding Header, ElementName=ShowSourcePlayButtonToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <ToggleSwitch x:Name="ShowSourcePlayButtonToggle"
                                                Header="Show play button">
        <ToggleSwitch.HeaderTemplate>
        <DataTemplate>
        <Grid Height="0"/>
        </DataTemplate>
        </ToggleSwitch.HeaderTemplate>
        </ToggleSwitch>
        </controls:FluentSettingRow>
                                        <controls:FluentSettingRow>
        <TextBlock Text="{Binding Header, ElementName=ShowSwapButtonToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        <ToggleSwitch x:Name="ShowSwapButtonToggle"
                                                Header="Show swap button">
        <ToggleSwitch.HeaderTemplate>
        <DataTemplate>
        <Grid Height="0"/>
        </DataTemplate>
        </ToggleSwitch.HeaderTemplate>
        </ToggleSwitch>
        </controls:FluentSettingRow>


                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HistoryPrivacySection"
                                Spacing="12">
                        <TextBlock x:Name="HistoryPrivacyHeaderText"
                                   Text="History &amp; privacy"
                                   FontSize="16"
                                   FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="12">
                                <controls:FluentSettingRow>
                                    <TextBlock x:Name="HistoryEnabledTitleText" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <ToggleSwitch x:Name="HistoryEnabledToggle" Grid.Column="1"
                                              AutomationProperties.AutomationId="HistoryEnabledToggle"
                                              Header="Save query history"
                                              Toggled="OnHistoryEnabledToggled"/>
                                </controls:FluentSettingRow>
                                <TextBlock x:Name="HistoryPrivacyDescriptionText" Text="Stores successful queries. Turning this off stops new history and keeps existing records. Long documents are never saved."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <controls:FluentSettingRow>
                                    <TextBlock x:Name="HistoryRetentionTitleText" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <NumberBox x:Name="HistoryRetentionDaysBox" Grid.Column="1"
                                           AutomationProperties.AutomationId="HistoryRetentionDaysBox"
                                           Header="History retention (days)"
                                           Minimum="1"
                                           Maximum="3650"
                                           SmallChange="1"
                                           LargeChange="30"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="OnHistoryRetentionDaysValueChanged"/>
                                </controls:FluentSettingRow>
                                <TextBlock x:Name="HistoryRetentionDescriptionText" Text="Default: 30 days (1–3650). Favorites are kept when history expires or is cleared."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="HistoryRetentionValidationText"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <Button x:Name="ClearHistoryButton"
                                        AutomationProperties.AutomationId="ClearHistoryButton"
                                        Content="Clear history"
                                        HorizontalAlignment="Left"
                                        Click="OnClearHistoryClicked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TTS Output Settings -->
                    <StackPanel x:Name="TtsSettingsSection" Spacing="12">
                        <TextBlock x:Name="TtsSettingsHeaderText"
                                   Text="TTS Output Settings"
                                   FontSize="18"
                                   FontWeight="SemiBold"  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TtsSpeedLabelText"
                                               Text="TTS Reading Speed (0.5x - 3.0x)"  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <Slider x:Name="TtsSpeedSlider"
                                            Minimum="0.5" Maximum="3.0" StepFrequency="0.5"
                                            Value="1.0" Width="250" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TtsVoiceLabelText"  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="TtsVoiceCombo"
                                                  Width="300"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                        <Button x:Name="TtsVoiceRefreshButton"
                                                Click="OnTtsVoiceRefreshClicked"
                                                VerticalAlignment="Center"
                                                Width="32" Height="32"
                                                Padding="8,4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        </Button>
                                        <ProgressRing x:Name="TtsVoiceRefreshProgress"
                                                      Width="20" Height="20"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="TtsVoicePreviewButton"
                                            Click="OnTtsVoicePreviewClicked"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="TtsVoicePreviewIcon"
                                                      Glyph="&#xE768;"
                                                      FontSize="14" />
                                            <TextBlock x:Name="TtsVoicePreviewButtonText"
                                                       Text="Play sample"  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <controls:FluentSettingRow>
<TextBlock Text="{Binding Header, ElementName=AutoPlayTranslationToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
<ToggleSwitch x:Name="AutoPlayTranslationToggle"
                                              Header="Auto-play translation"
                                              IsOn="False" >
<ToggleSwitch.HeaderTemplate>
<DataTemplate>
<Grid Height="0"/>
</DataTemplate>
</ToggleSwitch.HeaderTemplate>
</ToggleSwitch>
</controls:FluentSettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    </StackPanel>

                    <StackPanel x:Name="AboutTabContent"
                                Spacing="24"
                                Visibility="Collapsed">
                    <!-- About -->
                    <StackPanel x:Name="AboutSection"
                            Spacing="12">
                        <TextBlock x:Name="AboutHeaderText"
                                Text="About"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock AutomationProperties.AutomationId="AboutAppNameText"
                                        FontWeight="SemiBold"
                                        Text="Easydict for Windows ᵇᵉᵗᵃ"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="VersionText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <HyperlinkButton AutomationProperties.AutomationId="GitHubRepositoryLink"
                                        Content="GitHub Repository"
                                        NavigateUri="https://github.com/xiaocang/easydict_win32"
                                        Style="{StaticResource SettingsLinkButtonStyle}"/>
                                <HyperlinkButton x:Name="IssueFeedbackLink"
                                        AutomationProperties.AutomationId="IssueFeedbackLink"
                                        Content="Issue Feedback"
                                        NavigateUri="https://github.com/xiaocang/easydict_win32/issues/new/choose"
                                        Style="{StaticResource SettingsLinkButtonStyle}"/>
                                <HyperlinkButton x:Name="RateAppLink"
                                        AutomationProperties.AutomationId="MicrosoftStoreRatingLink"
                                        Content="Rate this app"
                                        Click="OnRateAppLinkClick"
                                        Visibility="Collapsed"
                                        Style="{StaticResource SettingsLinkButtonStyle}"/>

                                <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                    <TextBlock Text="Inspired by"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"/>
                                    <HyperlinkButton AutomationProperties.AutomationId="InspiredByLink"
                                            Content="Easydict for macOS"
                                            NavigateUri="https://github.com/tisfeng/Easydict"
                                            FontSize="12"
                                            Style="{StaticResource SettingsLinkButtonStyle}"/>
                                </StackPanel>

                                <TextBlock Text="License: GPL-3.0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    </StackPanel>

                    <StackPanel x:Name="AdvancedTabContent"
                                Spacing="24"
                                Visibility="Collapsed">
                    <!-- OCR (Text Recognition) Settings -->
                    <StackPanel x:Name="OcrSettingsSection"
                            Spacing="12">
                        <TextBlock x:Name="OcrSettingsHeaderText"
                                Text="OCR (Text Recognition) Settings"
                                FontSize="18"
                                FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="16">
                                <ComboBox x:Name="OcrEngineCombo"
                                        Header="OCR Engine"
                                        Width="300">
                                    <ComboBoxItem x:Name="OcrEngineNativeItem"
                                            Content="Default (Windows Native)"
                                            Tag="WindowsNative"/>
                                    <ComboBoxItem x:Name="OcrEngineOllamaItem"
                                            Content="Ollama (Local VLM)"
                                            Tag="Ollama"/>
                                    <ComboBoxItem x:Name="OcrEngineCustomApiItem"
                                            Content="Custom API"
                                            Tag="CustomApi"/>
                                </ComboBox>


                                <!-- Advanced OCR Settings -->
                                <StackPanel x:Name="AdvancedOcrPanel"
                                        Spacing="12"
                                        Visibility="Collapsed">
                                    <StackPanel MaxWidth="350"
                                                HorizontalAlignment="Left"
                                                Spacing="4">
                                        <TextBlock x:Name="OcrApiKeyHeaderText"
                                                   Text="API Key (Optional)"
                                                   FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <Grid>
                                            <PasswordBox x:Name="OcrApiKeyBox"
                                                         HorizontalAlignment="Stretch"
                                                         Padding="12,5,40,5"
                                                         PlaceholderText="Enter API key if required"
                                                         PasswordRevealMode="Hidden"/>
                                            <Button x:Name="OcrApiKeyRevealButton"
                                                    AutomationProperties.AutomationId="OcrApiKeyRevealButton"
                                                    Style="{StaticResource SettingsInlineIconButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding ElementName=OcrApiKeyBox}"
                                                    Click="OnPasswordRevealButtonClick">
                                                <FontIcon Glyph="&#xE890;"
                                                          FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <TextBox x:Name="OcrEndpointBox"
                                            Header="Endpoint"
                                            MaxWidth="350"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="http://localhost:11434/api/generate"/>

                                    <TextBox x:Name="OcrModelBox"
                                            Header="Model"
                                            MaxWidth="350"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="glm-ocr"/>

                                    <TextBox x:Name="OcrSystemPromptBox"
                                            Header="System Prompt"
                                            MaxWidth="350"
                                            Height="100"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="Enter system prompt for OCR..."/>

                                    <StackPanel Spacing="4">
                                        <controls:FluentSettingRow>
<TextBlock Text="{Binding Header, ElementName=OcrEnableThinkingToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
<ToggleSwitch x:Name="OcrEnableThinkingToggle"
                                                AutomationProperties.AutomationId="OcrEnableThinkingToggle"
                                                Header="Enable model thinking">
<ToggleSwitch.HeaderTemplate>
<DataTemplate>
<Grid Height="0"/>
</DataTemplate>
</ToggleSwitch.HeaderTemplate>
</ToggleSwitch>
</controls:FluentSettingRow>
                                        <TextBlock x:Name="OcrEnableThinkingDescriptionText"
                                                Text="Only applies to models that support thinking. Leaving it off makes recognition much faster."
                                                FontSize="12"
                                                MaxWidth="350"
                                                HorizontalAlignment="Left"
                                                TextWrapping="Wrap"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <Button x:Name="TestOcrConnectionButton"
                                            Content="Test OCR Connection"
                                            Click="OnTestOcrConnection"/>

                                    <TextBox x:Name="OcrTestStatusBox"
                                            Header="Test Result"
                                            IsReadOnly="True"
                                            MaxWidth="350"
                                            MinHeight="32"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Layout Detection (Long Document) -->

                    <!-- CJK Font -->

                    <!-- Formula Detection -->

                    <!-- Translation Cache -->
                    <StackPanel x:Name="TranslationCacheSection"
                            Spacing="12">
                        <TextBlock x:Name="TranslationCacheHeaderText"
                                Text="Translation Cache"
                                FontSize="18"
                                FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TranslationCacheDescriptionText"
                                   Text="Cache translated segments locally to speed up repeated translations and save API costs."
                                   FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="16">
                                <controls:FluentSettingRow>
<TextBlock Text="{Binding Header, ElementName=TranslationCacheToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
<ToggleSwitch x:Name="TranslationCacheToggle"
                                        Header="Enable Translation Cache"
                                              Toggled="OnTranslationCacheToggled">
<ToggleSwitch.HeaderTemplate>
<DataTemplate>
<Grid Height="0"/>
</DataTemplate>
</ToggleSwitch.HeaderTemplate>
</ToggleSwitch>
</controls:FluentSettingRow>
                                <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                    <Button x:Name="ClearCacheButton"
                                            Content="Clear Cache"
                                            Click="OnClearCacheClick"/>
                                    <TextBlock x:Name="CacheStatusText"
                                            Text=""
                                            VerticalAlignment="Center"
                                               FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="TranslationCacheNoteText"
                                           Text="Cached translations are stored locally in SQLite. Clear cache if translations become stale."
                                           FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Custom LLM Prompt -->
                    <StackPanel x:Name="CustomPromptSection"
                            Spacing="12">
                        <TextBlock x:Name="CustomPromptHeaderText"
                                Text="Custom Translation Prompt"
                                FontSize="18"
                                FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CustomPromptDescriptionText"
                                   Text="Add custom instructions for LLM-based translation services (OpenAI, DeepSeek, Gemini, etc.)."
                                   FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="16">
                                <TextBox x:Name="CustomPromptBox"
                                        Header="Additional Instructions"
                                         Width="450"
                                        Height="120"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                         PlaceholderText="e.g. You are translating a medical research paper. Preserve all LaTeX commands and scientific terminology."
                                         HorizontalAlignment="Left"
                                        TextChanged="OnCustomPromptChanged"/>
                                <TextBlock x:Name="CustomPromptNoteText"
                                           Text="These instructions are appended to the system prompt for LLM services. Has no effect on non-LLM services (Google, DeepL, etc.)."
                                           FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- HTTP Proxy -->
                    <StackPanel x:Name="HttpProxySection"
                            Spacing="12">
                        <TextBlock x:Name="HttpProxyHeaderText"
                                Text="HTTP Proxy"
                                FontSize="18"
                                FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel Spacing="16">
                                <controls:FluentSettingRow>
<TextBlock Text="{Binding Header, ElementName=ProxyEnabledToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
<ToggleSwitch x:Name="ProxyEnabledToggle"
                                        Header="Use HTTP Proxy">
<ToggleSwitch.HeaderTemplate>
<DataTemplate>
<Grid Height="0"/>
</DataTemplate>
</ToggleSwitch.HeaderTemplate>
</ToggleSwitch>
</controls:FluentSettingRow>
                                <TextBox x:Name="ProxyUriBox"
                                        Header="Proxy URL"
                                        Width="300"
                                         PlaceholderText="http://127.0.0.1:7890"/>
                                <controls:FluentSettingRow>
<TextBlock Text="{Binding Header, ElementName=ProxyBypassLocalToggle}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
<ToggleSwitch x:Name="ProxyBypassLocalToggle"
                                        Header="Bypass proxy for localhost"
                                        IsOn="True">
<ToggleSwitch.HeaderTemplate>
<DataTemplate>
<Grid Height="0"/>
</DataTemplate>
</ToggleSwitch.HeaderTemplate>
</ToggleSwitch>
</controls:FluentSettingRow>
                                <TextBlock Text="Proxy changes take effect after app restart. Localhost bypass ensures Ollama works without proxy."
                                           FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    </StackPanel>
                </Grid>

                </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <!-- Floating Save Button (fixed at bottom-right) -->
        <Button x:Name="SaveButton"
                Content="Save Settings"
                Click="OnSaveClick"
                Style="{StaticResource SettingsAccentButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,32,32"
                Padding="24,12"
                Visibility="Collapsed">
            <Button.Shadow>
                <ThemeShadow/>
            </Button.Shadow>
        </Button>

        <Grid x:Name="NavigationLoadingOverlay"
              Visibility="Collapsed"
              Canvas.ZIndex="100"
              IsHitTestVisible="True">
            <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Opacity="0.72"/>
            <ProgressRing x:Name="NavigationLoadingRing"
                          IsActive="False"
                          Width="36"
                          Height="36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
